@model RealTimeApplication.Operations.Handlers.Identity.RegistrationFormRequest;
<div>
    <form asp-action="SignUp" asp-controller="Identity">
        <input asp-for="FirstName" type="text" placeholder="First Name" required/>
        <input asp-for="LastName" type="text" placeholder="Last Name" required/>
        <input asp-for="Email" type="email" placeholder="Email" required/>
        <input asp-for="Password" type="text" placeholder="Password" required/>
        <input type="submit" value="Register" />
    </form>
</div>